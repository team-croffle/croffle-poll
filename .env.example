NUXT_DB_HOST=your-pg-url
NUXT_DB_PORT=your-pg-port
NUXT_DB_USER=your-pg-user
NUXT_DB_PASSWORD=your-pg-password
NUXT_DB_DATABASE=your-pg-database
NUXT_SESSION_PASSWORD=your-session-password

# OIDC client (any OpenID Connect provider: Dex, Google, Authentik, ...)
NUXT_OAUTH_OIDC_CLIENT_ID=your-oidc-client-id
NUXT_OAUTH_OIDC_CLIENT_SECRET=your-oidc-client-secret
# Discovery document URL, e.g. https://dex.example.com/.well-known/openid-configuration
#                              https://accounts.google.com/.well-known/openid-configuration
NUXT_OAUTH_OIDC_OPENID_CONFIG=https://your-issuer/.well-known/openid-configuration
# Optional: set when the public URL cannot be detected behind a proxy (callback path is /auth/oidc)
# NUXT_OAUTH_OIDC_REDIRECT_URL=https://poll.example.com/auth/oidc

# Space separated scopes. Add `groups` for Dex/Authentik; Google does not support it.
NUXT_OIDC_SCOPE=openid profile email groups
# Claim holding group names (default: groups)
NUXT_OIDC_GROUPS_CLAIM=groups
# Comma separated. A user matching either list becomes ADMIN; everyone else is MEMBER.
# Dex + GitHub groups look like `org` or `org:team`.
NUXT_OIDC_ADMIN_GROUPS=your-org:your-admin-team
NUXT_OIDC_ADMIN_EMAILS=admin@example.com

# Label on the login button ("Login with <name>")
NUXT_PUBLIC_OIDC_PROVIDER_NAME=GitHub
